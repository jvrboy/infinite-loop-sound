# DivergenceIQ — Environment variables example
#
# Copy this file to `.env` (gitignored) for local development, or set these as
# secrets in your deployment platform (Hugging Face Spaces → Settings → Variables,
# Vercel → Project Settings, Cloudflare → Pages env, GitLab CI variables, etc.).
#
# The app works WITHOUT Supabase env vars (Supabase features will be disabled
# and a single console.warn shows). It does not crash.

# ---- Supabase (browser-safe) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-PUBLIC-KEY
# Alias also supported (some Supabase docs use ANON_KEY):
# VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- Supabase (server-only — NEVER expose to the browser) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Deriv ----
VITE_DERIV_APP_ID=1089

# ---- AI providers (optional) ----
# VITE_OPENAI_API_KEY=sk-...
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# VITE_GOOGLE_API_KEY=...

# ---- Telegram bot (optional) ----
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# ---- Hugging Face proxy (optional) ----
# HF_TOKEN=hf_...
